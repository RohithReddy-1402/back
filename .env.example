# ---- Core ----
PORT=3001
JWT_SECRET=change-me

# ---- MongoDB ----
# NOTE: server.js currently hardcodes the connection string; migrate it to this.
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ---- Appwrite (legacy storage) ----
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=

# ---- Mail (SMTP / Resend) ----
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# ---- Email verification (signup) ----
# FRONTEND_URL: where /api/email-verification/verify redirects after a click.
# BACKEND_URL: base URL baked into the verify link sent by email; falls back to
# the inbound request's protocol/host if unset (fine for local dev only).
FRONTEND_URL=https://nitkkrpyqs.in
BACKEND_URL=https://back-6j6v.onrender.com
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_WINDOW_MINUTES=15
EMAIL_VERIFICATION_RESEND_MAX=3

# ---- Paper approval mail scheduler ----
PAPER_MAIL_IDLE_MINUTES=30
PAPER_MAIL_MAX_HOURS=24
PAPER_MAIL_SWEEP_MINUTES=5

# ---- Redis (Upstash). Leave unset to run Mongo-only. ----
REDIS_URL=rediss://default:password@host:6379

# ---- Download rate limiting (anonymous traffic only; users are unlimited) ----
DL_RATE_PER_MIN=3
DL_RATE_PER_HOUR=10
DL_RATE_PER_DAY=20

# ---- Redis cache / counter tuning ----
PAPERS_CACHE_TTL_SECONDS=600
DOWNLOAD_FLUSH_SECONDS=60
